{
  "dashboard": {
    "title": "Inference Service Monitoring",
    "description": "Throughput, latency, CPU, and memory monitoring for inference service",
    "tags": ["inference", "monitoring", "performance"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Requests Per Second",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(inference_requests_total[1m])",
            "legendFormat": "Requests/sec",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Error Rate (%)",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(inference_requests_total{status=\"error\"}[1m]) / rate(inference_requests_total[1m]) * 100",
            "legendFormat": "Error Rate %",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Headlines Processed Per Second",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "rate(headlines_processed_total[1m])",
            "legendFormat": "Headlines/sec",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Active Requests",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "inference_active_requests",
            "legendFormat": "Active Requests",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Latency P50 (Median)",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(inference_request_duration_seconds_bucket[1m]))",
            "legendFormat": "P50",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Latency P95",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 16
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(inference_request_duration_seconds_bucket[1m]))",
            "legendFormat": "P95",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Latency P99",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 16
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(inference_request_duration_seconds_bucket[1m]))",
            "legendFormat": "P99",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "CPU Usage (Cores)",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 24
        },
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{container_name=\"inference-service\"}[1m])",
            "legendFormat": "Inference Service",
            "refId": "A"
          },
          {
            "expr": "rate(container_cpu_usage_seconds_total{container_name=\"ingestion-service\"}[1m])",
            "legendFormat": "Ingestion Service",
            "refId": "B"
          }
        ]
      },
      {
        "id": 9,
        "title": "Memory Usage (MB)",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 24
        },
        "targets": [
          {
            "expr": "container_memory_usage_bytes{container_name=\"inference-service\"} / 1024 / 1024",
            "legendFormat": "Inference Service",
            "refId": "A"
          },
          {
            "expr": "container_memory_usage_bytes{container_name=\"ingestion-service\"} / 1024 / 1024",
            "legendFormat": "Ingestion Service",
            "refId": "B"
          }
        ]
      },
      {
        "id": 10,
        "title": "Memory as % of Limit",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 32
        },
        "targets": [
          {
            "expr": "container_memory_usage_bytes{container_name=\"inference-service\"} / container_spec_memory_limit_bytes{container_name=\"inference-service\"} * 100",
            "legendFormat": "Inference Service %",
            "refId": "A"
          },
          {
            "expr": "container_memory_usage_bytes{container_name=\"ingestion-service\"} / container_spec_memory_limit_bytes{container_name=\"ingestion-service\"} * 100",
            "legendFormat": "Ingestion Service %",
            "refId": "B"
          }
        ]
      },
      {
        "id": 11,
        "title": "Headlines per CPU Core",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 32
        },
        "targets": [
          {
            "expr": "rate(headlines_processed_total[1m]) / rate(container_cpu_usage_seconds_total{container_name=\"inference-service\"}[1m])",
            "legendFormat": "Efficiency",
            "refId": "A"
          }
        ]
      }
    ],
    "refresh": "5s",
    "schemaVersion": 27,
    "style": "dark",
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {},
    "uid": "inference-monitoring",
    "version": 1
  }
}